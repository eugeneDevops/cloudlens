{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(./out/**)",
      "Read(**/Migrations/**)",
      "Read(**/*.Designer.cs)",
      "Read(**/*.g.cs)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./.env)",
      "Read(**/appsettings.Development.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-domain.sh\""
          }
        ]
      }
    ]
  }
}
